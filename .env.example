# Default development path: npm ci && npm run dev:lokal
# The Firebase CLI supplies emulator hosts. Never point emulators at production.
# Do not set NODE_ENV=production for emulator development.
# For cloud integration use ADC / Workload Identity; never paste service-account JSON.

# Optional cloud project/database overrides; leave unset for demo-klar emulators.
# GCLOUD_PROJECT=
# FIRESTORE_DATABASE_ID=

PORT=3000
TRUST_PROXY_HOPS=0

# Optional integrations: obtain development credentials only when needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
DIDIT_API_KEY=
DIDIT_ENABLED=false
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_APPLICATION_ID=
DIDIT_ENVIRONMENT=sandbox
DIDIT_CALLBACK_URL=
DIDIT_PRIVACY_NOTICE_URL=
DIDIT_PRIVACY_NOTICE_VERSION=
KLAR_PUBLIC_URL=

# Production only: provision independent high-entropy secrets via Secret Manager.
# CONSENT_AUDIT_SECRET must be at least 32 characters.
# Consent can also use AUDIT_LOG_SECRET_KEY; a dedicated key is preferable.
# CONSENT_AUDIT_SECRET=
# AUDIT_LOG_SECRET_KEY=
# METRICS_TOKEN=

# OpenTelemetry: traces and Prometheus-compatible metrics are exposed only through the protected metrics interface.
OTEL_SERVICE_NAME=klar-api
# Optional OTLP/HTTP collector endpoint; leave unset to use the protected local metrics interface only.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example.invalid/v1/traces
# Error reporting only, after explicit consent. Browser tracing is disabled.
VITE_SENTRY_DSN=

# Same high-entropy Secret Manager value in the API and the Frankfurt scheduler.
COMPLIANCE_JOB_SECRET=
# Configure COMPLIANCE_API_ORIGIN in functions deployment to the exact HTTPS API origin.
SENDGRID_FROM_EMAIL=

# Scheduled KYC reconciliation; high entropy, shared only with the maintenance scheduler.
KYC_RECONCILIATION_JOB_SECRET=
KLAR_API_ORIGIN=https://api.example.invalid
