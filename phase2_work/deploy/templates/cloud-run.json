{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "klar-app-backend",
    "annotations": {
      "run.googleapis.com/ingress": "all"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/maxScale": "10",
          "autoscaling.knative.dev/minScale": "0",
          "run.googleapis.com/cpu-throttling": "true"
        }
      },
      "spec": {
        "containers": [
          {
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "env": [
              {
                "name": "NODE_ENV",
                "value": "production"
              },
              {
                "name": "LOG_LEVEL",
                "value": "warn"
              }
            ],
            "resources": {
              "limits": {
                "memory": "512Mi",
                "cpu": "1"
              }
            }
          }
        ],
        "containerConcurrency": 80
      }
    }
  }
}
