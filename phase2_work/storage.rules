rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Klar — Storage-Regeln. Vorgabe ist Verweigerung.
//
// Die frühere clientseitige Gesten-/Fotoverifizierung ist eingestellt.
// KYC erfolgt über den externen Didit-Prozess. Die Legacy-Storage-Pfade
// enthalten potentiell biometrische Daten (DSGVO Art. 9) und sind für
// sämtliche Firebase-Clientoperationen gesperrt. Nur autorisierte Admin-SDK-
// Workflows dürfen bestehende Bilder für Retention/Art. 17 bearbeiten.
// WICHTIG: Admin SDK umgeht Firebase Storage Rules; IAM separat prüfen.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    // GAST-01 (14.08.2026): Ein Gastkonto laedt keine Bilder hoch. Weder ein
    // Profilfoto (es gibt kein Gastprofil) noch ein Verifizierungsfoto (ein
    // Gastkonto ist beim naechsten Besuch weg, die Pruefung waere umsonst).
    // Das verhindert zugleich, dass anonyme Konten Speicher fuellen.
    function istGast() {
      return signedIn()
             && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function istBild() { return request.resource != null && request.resource.contentType != null && request.resource.contentType.matches('image/(jpeg|png|webp)'); }

    // Source of truth: the server-owned users/{uid} document. Never use
    // client-supplied birthdate, mutable age, or an unissued isAdult JWT claim.
    // Rules are limited to TWO distinct default-Firestore docs per request.
    // Missing documents, age flags and non-active states fail closed.
    function istAktiverErwachsener(uid) {
      // Guard absent records before accessing .data; unknown users deny access.
      return firestore.exists(/databases/(default)/documents/users/$(uid))
          && firestore.get(/databases/(default)/documents/users/$(uid)).data.isAdult == true
          && firestore.get(/databases/(default)/documents/users/$(uid)).data.accountStatus == 'active';
    }

    match /verification/{uid}/{datei} {
      // Zero-client-access: no new biometric uploads, no overwrite after
      // a purge receipt, no reads and no client-side deletion.
      allow read: if false;
      allow create, update: if false;
      allow delete: if false;   // Nur Admin SDK (separate IAM boundary)
    }

    match /profiles/{uid}/{datei} {
      // Reader and profile owner must BOTH have a server-authoritative
      // active-adult account; anonymous users and unknown ages are denied.
      allow read: if signedIn() && !istGast()
                  && istAktiverErwachsener(request.auth.uid)
                  && istAktiverErwachsener(uid);
      allow create, update: if signedIn() && !istGast() && request.auth.uid == uid
                   && istAktiverErwachsener(uid)
                   && istBild() && request.resource.size < 8 * 1024 * 1024;
      allow delete: if signedIn() && !istGast() && request.auth.uid == uid
                    && istAktiverErwachsener(uid);
    }
  }
}

