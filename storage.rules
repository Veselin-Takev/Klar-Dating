rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Klar — Storage-Regeln. Vorgabe ist Verweigerung.
//
// Das Verifizierungsfoto ist ein biometrisches Datum im Sinne von Art. 9
// DSGVO, sobald es zum Abgleich dient. Deshalb: schreiben ja, LESEN NEIN —
// auch nicht für die eigene Person. Ein lesbarer Pfad ist ein teilbarer
// Pfad, und ein Foto mit vorgegebener Geste ist genau das Material, mit dem
// sich ein fremdes Konto verifizieren ließe. Die Sichtprüfung läuft über das
// Admin-SDK und braucht die Client-Leseberechtigung nicht.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null && !('tenantId' in request.auth.token) && !('tenant_id' in request.auth.token) && (!('firebase' in request.auth.token) || !('tenant' in request.auth.token.firebase)); }
    // GAST-01 (14.08.2026): Ein Gastkonto laedt keine Bilder hoch. Weder ein
    // Profilfoto (es gibt kein Gastprofil) noch ein Verifizierungsfoto (ein
    // Gastkonto ist beim naechsten Besuch weg, die Pruefung waere umsonst).
    // Das verhindert zugleich, dass anonyme Konten Speicher fuellen.
    function istGast() {
      return signedIn()
             && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function istBild() { return request.resource != null && request.resource.contentType != null && request.resource.contentType.matches('image/(jpeg|png|webp)'); }

    // Authorization uses server-owned Firestore state, never an isAdult claim.
    // Cross-service lookup failure/missing data denies access. Only the supported
    // default database/tenant namespace is eligible; no legacy-data fallback.
    function activeAdult(uid) {
      // At most two Firestore documents per Storage request. The server writes
      // this fence atomically with the deletion job; missing legacy fences deny.
      let user = firestore.get(/databases/(default)/documents/tenants/default/users/$(uid)).data;
      return user.isAdult == true && (!('active' in user) || user.active != false) && user.mediaAccessState == 'active';
    }
    function eligibleReader() {
      return signedIn() && !istGast() && activeAdult(request.auth.uid);
    }

    match /verification/{uid}/{datei} {
      allow read: if false;
      // Legacy verification upload endpoints are retired. Direct uploads can
      // mint download capabilities even when reads are forbidden.
      allow create, update: if false;
      allow delete: if false;   // nur serverseitig, nach der Entscheidung
    }

    match /profiles/{uid}/{datei} {
      allow read: if false; // Protected reads require the token-verified API.
      // Profile writes go through the authenticated API, which creates no
      // long-lived Firebase download capabilities.
      allow create, update: if false;
      allow delete: if eligibleReader() && request.auth.uid == uid;
    }
  }
}

